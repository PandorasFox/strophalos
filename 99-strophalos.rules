# ASUS BW-16D1HT (SATA) — serial YOUR_SERIAL
# Creates /dev/strophalos/disc (sr) and /dev/strophalos/sg (scsi generic)
# and grants rw access without sudo.
# Requires: modprobe sg (or /etc/modules-load.d/sg.conf for persistence)

# sr (block) device
SUBSYSTEM=="block", KERNEL=="sr*", ENV{ID_SERIAL_SHORT}=="YOUR_SERIAL", MODE="0666", SYMLINK+="strophalos/disc"

# sg (scsi_generic) device — needed by MakeMKV and sg_write_buffer
SUBSYSTEM=="scsi_generic", KERNEL=="sg*", ATTRS{model}=="BW-16D1HT       ", MODE="0666", SYMLINK+="strophalos/sg"
